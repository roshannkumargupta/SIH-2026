# Copy this file to .env and add your API key. Never commit .env.

# Required: Sarvam API key used for:
#   - Speech-to-text  (/api/transcribe)
#   - Text-to-speech  (/api/speak  — Hindi only)
#   - LLM intent classification (/api/interpret  — understands any phrasing)
SARVAM_API_KEY=your_sarvam_api_key_here
PORT=3000
